# Copy to .env.local (app) and .env.test.local (tests/migrations). Never commit real values.

# Public — safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Used by the FX cron route (production) and by the test suite.
SUPABASE_SECRET_KEY=sb_secret_...
CRON_SECRET=<random string; Vercel sends it as Bearer token to the cron route>

# Tests/migrations only (.env.test.local). Points at the TEST project, never production.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
