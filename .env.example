# Copy to .env.local (app) and .env.test.local (tests/migrations). Never commit real values.

# Public — safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Required in production: emails, stored invoices and password reset links.
SUPABASE_SECRET_KEY=sb_secret_...

# Public address of the site, used in email links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Emails (Resend). Without RESEND_API_KEY they are recorded as "skipped" and nothing is sent.
# The sending domain must be verified in Resend (SPF and DKIM).
RESEND_API_KEY=re_...
EMAIL_FROM=Rent for Events <reservations@example.com>
EMAIL_REPLY_TO=contact@example.com
# Receives notices for new requests, accepted quotes, payments and returns.
STAFF_NOTIFY_EMAIL=equipe@example.com

# Protects /api/cron/emails. Any long random string.
CRON_SECRET=change-me
# Derives guest tracking links. Changing it invalidates the links already sent.
TRACKING_TOKEN_SECRET=change-me-too

# Tests/migrations only (.env.test.local). Points at the TEST project, never production.
# The integration suite refuses to run unless the URL host starts with this ref.
TEST_PROJECT_REF=<test-project-ref>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
